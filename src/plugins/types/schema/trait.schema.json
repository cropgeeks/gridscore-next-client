{
  "$ref": "#/definitions/Trait",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "Group": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        }
      },
      "type": "object"
    },
    "MinimalVariableInfo": {
