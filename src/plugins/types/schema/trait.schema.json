        "methodClass": {
          "type": "string"
        },
        "methodDescription": {
          "type": "string"
        },
        "methodId": {
          "type": "string"
        },
        "methodIsTimeseries": {
          "type": "boolean"
        },
        "methodName": {
          "type": "string"
        },
        "methodOntologyId": {
          "type": "string"
        },
        "methodOntologyName": {
          "type": "string"
        },
        "methodSetSize": {
          "type": "number"
        },
        "scaleDataType": {
          "type": "string"
        },
        "scaleDescription": {
          "type": "string"
        },
        "scaleId": {
          "type": "string"
        },
        "scaleMaxValue": {
          "type": "number"
        },
        "scaleMinValue": {
          "type": "number"
        },
        "scaleName": {
          "type": "string"
        },
        "scaleOntologyId": {
          "type": "string"
        },
        "scaleOntologyName": {
          "type": "string"
        },
        "scaleUnit": {
          "type": "string"
        },
        "scaleValidValues": {
          "items": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "type": "array"
        },
        "traitAbbreviation": {
          "type": "string"
        },
        "traitCategory": {
          "type": "string"
        },
        "traitClass": {
          "type": "string"
        },
        "traitDescription": {
          "type": "string"
        },
        "traitId": {
          "type": "string"
        },
        "traitName": {
          "type": "string"
        },
        "traitOntologyId": {
          "type": "string"
        },
        "traitOntologyName": {
          "type": "string"
        },
        "variableDescription": {
          "type": "string"
        },
        "variableId": {
          "type": "string"
        },
        "variableName": {
          "type": "string"
        },
        "variableOntologyId": {
          "type": "string"
        },
        "variableOntologyName": {
          "type": "string"
        }
      },
      "required": [
        "variableId",
        "variableName",
        "traitId",
        "traitName",
        "methodId",
        "methodName",
        "scaleId",
        "scaleName",
        "scaleDataType"
      ],
      "type": "object"
    },
    "Restrictions": {
      "additionalProperties": false,
      "properties": {
        "categories": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "max": {
          "type": "number"
        },
        "min": {
          "type": "number"
        },
        "step": {
          "type": "number"
        }
      },
      "type": "object"
    },
    "Timeframe": {
      "additionalProperties": false,
      "properties": {
        "end": {
          "type": "string"
        },
        "start": {
          "type": "string"
        },
        "type": {
          "$ref": "#/definitions/TimeframeType"
        }
      },
      "required": [
        "type"
      ],
      "type": "object"
    },
    "TimeframeType": {
      "enum": [
        "SUGGEST",
        "ENFORCE"
      ],
      "type": "string"
    },
    "Trait": {
      "additionalProperties": false,
      "properties": {
        "allowRepeats": {
          "type": "boolean"
        },
        "brapiId": {
          "type": "string"
        },
        "brapiVariable": {
          "$ref": "#/definitions/MinimalVariableInfo"
        },
        "dataType": {
          "$ref": "#/definitions/TraitDataType"
        },
        "description": {
          "type": "string"
        },
        "group": {
          "$ref": "#/definitions/Group"
        },
        "hasImage": {
          "type": "boolean"
        },
        "id": {
          "type": "string"
        },
        "imageUrl": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "restrictions": {
          "$ref": "#/definitions/Restrictions"
        },
        "setSize": {
          "type": "number"
        },
        "timeframe": {
          "$ref": "#/definitions/Timeframe"
        }
      },
      "required": [
        "name",
        "dataType",
        "allowRepeats",
        "setSize"
      ],
      "type": "object"
    },
    "TraitDataType": {
      "enum": [
        "int",
        "float",
        "range",
        "categorical",
        "multicat",
        "boolean",
        "date",
        "gps",
        "image",
        "video",
        "text",
        "vegindex"
      ],
      "type": "string"
    }
  }
}